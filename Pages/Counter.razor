@page "/counter"

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">Click me</button>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        // Debugging scenario: increment currentCount by one, 5 times,
        // using print statements to inspect the loop in the VS Code terminal.
        Console.WriteLine($"Before loop: currentCount = {currentCount}");

        for (int i = 0; i < 5; i++)
        {
            currentCount++;
            Console.WriteLine($"Iteration {i}: currentCount = {currentCount}");
        }

        Console.WriteLine($"After loop: currentCount = {currentCount}");
    }
}
